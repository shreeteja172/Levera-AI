# ---------------------------------------------------------------------------
# Levera — environment variables
#
# Copy to .env.local for development:   cp .env.example .env.local
# Every value below is a placeholder. Never commit a filled-in copy.
# ---------------------------------------------------------------------------


# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. Levera uses Neon with the pooled endpoint.
# Use the -pooler host in serverless environments or you will exhaust connections.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"


# --- Auth (better-auth) -----------------------------------------------------
# Random secret used to sign sessions. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="generate-a-32-byte-random-hex-string"

# Base URL of THIS deployment. Password-reset links are built from it, so a
# wrong value sends users to the wrong host.
#   local -> http://localhost:3000
#   prod  -> https://your-domain.com
BETTER_AUTH_URL="http://localhost:3000"


# --- Google OAuth -----------------------------------------------------------
# From Google Cloud Console > Credentials > OAuth 2.0 Client ID.
# Add BOTH callbacks to "Authorised redirect URIs":
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"


# --- Transactional email (Brevo) --------------------------------------------
# Required. Sign-in OTP codes and password-reset links are sent through this,
# so a misconfigured sender means users cannot log in at all.
BREVO_API_KEY="xkeysib-your-brevo-api-key"

# Must be a verified sender in Brevo. Configure SPF and DKIM on this domain,
# otherwise auth emails land in spam.
BREVO_SENDER_EMAIL="no-reply@your-domain.com"


# --- Rate limiting (Upstash Redis) ------------------------------------------
# REQUIRED IN PRODUCTION. The chat endpoints call the limiter directly, so if
# these are unset the chat API returns 500 and the app is unusable.
# Page-level limiting in proxy.ts fails open, so it degrades quietly instead.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"


# --- AI providers -----------------------------------------------------------
# At minimum set GROQ_API_KEY: it backs the default model and is the fallback
# whenever an unsupported model is requested. The rest are optional and only
# needed for the models you actually expose in lib/ai/model-list.ts.

# Default provider and fallback. https://console.groq.com/keys
GROQ_API_KEY="gsk_your-groq-key"

# Optional — OpenAI models.
OPENAI_API_KEY="sk-your-openai-key"

# Optional — Zhipu / GLM models (OpenAI-compatible endpoint).
ZHIPU_API_KEY="your-zhipu-key"

# Optional — OpenRouter models (OpenAI-compatible endpoint).
OPENROUTER_API_KEY="sk-or-your-openrouter-key"

# Optional — only if routing through the Vercel AI Gateway. Read implicitly by
# the AI SDK; not referenced anywhere in application code.
AI_GATEWAY_API_KEY="your-vercel-ai-gateway-key"

# Optional — Umami analytics. Leave unset in development and in forks so local
# traffic does not pollute production stats; the script only renders when set.
# The ID is public by design (it ships in the page HTML), so it is not a secret.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# Optional — only if self-hosting Umami. Defaults to https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=""
