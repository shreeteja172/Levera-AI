{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "DATABASE_URL",
        "AI_GATEWAY_API_KEY",
        "ZHIPU_API_KEY",
        "NODE_ENV",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_CLIENT_ID",
        "BETTER_AUTH_CLIENT_SECRET",
        "BETTER_AUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "BREVO_API_KEY",
        "BREVO_SENDER_EMAIL",
        "OPENROUTER_API_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    }
  }
}
